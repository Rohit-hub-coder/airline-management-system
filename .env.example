# Root Environment Configuration for Docker Compose
# Copy this file to .env and adjust variables as needed

# MySQL Root Password (used across all 4 microservice databases)
DB_PASSWORD=your_mysql_secure_password

# Host port mapped to MySQL container (default: 3307 to avoid collision with local MySQL on 3306)
HOST_MYSQL_PORT=3307

# RabbitMQ Message Broker Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Shared JWT Secret for token signing and verification across API Gateway and Services
JWT_KEY=your_shared_random_jwt_secret_key

# Nodemailer SMTP Configuration (Auth and Reminder services)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
